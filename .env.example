# Existing app configuration; copy to .env.local and supply project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Server only: restrict to Geocoding API and Places API. Google Cloud billing must be active.
# Used by authenticated address searches on web and mobile; never expose this key in public config.
GOOGLE_MAPS_SERVER_API_KEY=

# Server only: Directions API key for driving/walking route previews. Billing must be active.
GOOGLE_DIRECTIONS_API_KEY=

# Public telemetry settings (development stays off unless explicitly enabled).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_TELEMETRY_DEBUG=false
NEXT_PUBLIC_TELEMETRY_DISABLED=false

# Build server only; never prefix the upload token with NEXT_PUBLIC_.
SENTRY_ORG=yrdly-ltd
SENTRY_PROJECT=yrdly-app
SENTRY_AUTH_TOKEN=

# Server only: new event tickets use Payluk staging. Confirm native 3% commission
# in the matching Payluk dashboard; keep additional commission fees at zero.
PAYLUK_EVENT_CHECKOUT_ENABLED=false
PAYLUK_EVENT_NATIVE_COMMISSION_CONFIRMED=false
# Retain Paystack credentials only for subscriptions and legacy ticket recovery.
PAYSTACK_SECRET_KEY=
PAYSTACK_EVENT_CHECKOUT_ENABLED=false
PAYSTACK_SANDBOX_PROJECT_REF=
PAYSTACK_LOCAL_SANDBOX=false
PAYSTACK_TEST_ON_MAIN=false
PAYSTACK_TEST_USER_IDS=
PAYSTACK_TEST_ALLOW_ALL_USERS=false
# Live gates remain false until Manual Payouts approval and operational launch review.
PAYSTACK_LIVE_ENABLED=false
PAYSTACK_MANUAL_PAYOUTS_ENABLED=false
PAYSTACK_EVENT_OPERATIONS_APPROVED=false

# Payluk event finance: exact host/key/database binding is required in every mode.
# Live activation follows verified event acceptance and the authorized cutover.
PAYLUK_EVENT_LIVE_APPROVED=false
PAYLUK_EVENT_EXPECTED_PROJECT_REF=
PAYLUK_EVENT_FINANCE_ENABLED=false
# Enable independently only after event release and payout checks pass.
PAYLUK_EVENT_WITHDRAWALS_ENABLED=false

# Service booking milestone validation: exact host/key/database binding required.
# Live mode additionally requires the explicit approval and project binding below.
PAYLUK_STAGED_BOOKINGS_ENABLED=false
PAYLUK_STAGED_COMMISSION_CONFIRMED=false
# Keep funded-booking release/refund reconciliation available when new checkout is paused.
PAYLUK_STAGED_RECOVERY_ENABLED=false
# Production service activation remains separately authorized; never set for QA.
PAYLUK_STAGED_LIVE_APPROVED=false
PAYLUK_STAGED_EXPECTED_PROJECT_REF=

# Dedicated event-worker scheduler credential. Configure matching GitHub Actions
# secret and EVENT_PAYOUT_SCHEDULER_ENABLED repository variable only at cutover.
EVENT_PAYOUT_CRON_SECRET=
