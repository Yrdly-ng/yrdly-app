# Existing app configuration; copy to .env.local and supply project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Server only: restrict to Geocoding API and Places API. Google Cloud billing must be active.
# Used by authenticated address searches on web and mobile; never expose this key in public config.
GOOGLE_MAPS_SERVER_API_KEY=

# Server only: Directions API key for driving/walking route previews. Billing must be active.
GOOGLE_DIRECTIONS_API_KEY=

# Public telemetry settings (development stays off unless explicitly enabled).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_TELEMETRY_DEBUG=false
NEXT_PUBLIC_TELEMETRY_DISABLED=false

# Build server only; never prefix the upload token with NEXT_PUBLIC_.
SENTRY_ORG=yrdly-ltd
SENTRY_PROJECT=yrdly-app
SENTRY_AUTH_TOKEN=

# Server only: event ticket sandbox. Use a dedicated development Supabase project.
PAYSTACK_SECRET_KEY=
PAYSTACK_EVENT_CHECKOUT_ENABLED=false
PAYSTACK_SANDBOX_PROJECT_REF=
PAYSTACK_LOCAL_SANDBOX=false
PAYSTACK_TEST_ON_MAIN=false
PAYSTACK_TEST_USER_IDS=
PAYSTACK_TEST_ALLOW_ALL_USERS=false
# Live gates remain false until Manual Payouts approval and operational launch review.
PAYSTACK_LIVE_ENABLED=false
PAYSTACK_MANUAL_PAYOUTS_ENABLED=false
PAYSTACK_EVENT_OPERATIONS_APPROVED=false
