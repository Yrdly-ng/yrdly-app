    {
      "key": "active",
      "id": 13473928,
      "short_id": "qW9NZrnD",
      "name": "Active users across all platforms",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "TrendsQuery",
          "dateRange": {
            "date_from": "-30d"
          },
          "interval": "day",
          "filterTestAccounts": false,
          "properties": [
            {
              "key": "app_environment",
              "type": "event",
              "operator": "exact",
              "value": [
                "production"
              ]
            }
          ],
          "series": [
            {
              "kind": "GroupNode",
              "operator": "OR",
              "math": "dau",
              "custom_name": "All platforms",
              "nodes": [
                {
                  "kind": "EventsNode",
                  "event": "$screen",
                  "math": "dau"
                },
                {
                  "kind": "EventsNode",
                  "event": "$pageview",
                  "math": "dau"
                }
              ]
            }
          ],
          "trendsFilter": {
            "display": "ActionsBarValue"
          }
        }
      }
    },
